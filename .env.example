# ============================================================
# 织章 StoryLoom 环境变量
# 至少配置一个提供商；系统会按 config/model_config.yaml 自动降级
# ============================================================

# DeepSeek（必选推荐：中文写作 + 低成本兜底）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 可选：多模型组合能显著提升角色层次感与一致性校验可靠性
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# 可选：本地 Ollama（免费，无需密钥）
# OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# 兼容旧 Demo 的模型名配置（新代码以 model_config.yaml 为准）
# ------------------------------------------------------------
DEEPSEEK_MODEL_HEAVY=deepseek/deepseek-v4-pro
DEEPSEEK_MODEL_DEFAULT=deepseek/deepseek-flash
DEEPSEEK_MODEL_LIGHT=deepseek/deepseek-flash
